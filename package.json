{
  "name": "aws-serverless-ai-gateway",
  "version": "1.0.0",
  "type": "module",
  "description": "Serverless AI gateway on AWS, written in TypeScript",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-reporter=spec \"tests/unit/*.test.ts\"",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "diff": "cdk diff",
    "setup": "node scripts/setup.ts",
    "e2e": "node tests/e2e.ts",
    "loadtest": "cd loadtest && ./run.sh"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@aws-sdk/client-cloudformation": "^3.1152.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/client-firehose": "^3.1152.0",
    "@aws-sdk/credential-provider-node": "^3.972.86",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "@smithy/node-http-handler": "^4.12.1",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "aws-cdk": "^2.1145.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
